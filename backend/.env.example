# Copie este arquivo para backend/.env e preencha os valores.
# O .env NÃO vai para o git (tem senhas).

# ---- Banco PostgreSQL (Neon ou Azure) ----
# Ex. Neon: jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/ctiinsights?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/ctiinsights
DB_USER=postgres
DB_PASSWORD=

# ---- JWT: pelo menos 32 caracteres, aleatório ----
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# ---- Front que pode chamar a API ----
CORS_ORIGINS=http://localhost:5173

# ---- Primeiro administrador (criado só se ainda não existir) ----
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@cti.local
ADMIN_PASSWORD=

# ---- Upload ----
UPLOAD_MAX_LINHAS=5000

# ---- Python (ETL) ----
ETL_URL=http://localhost:8000/etl
ETL_KEY=
